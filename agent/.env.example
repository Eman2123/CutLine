# Devnet RPC
RPC_URL=https://api.devnet.solana.com

# Owner key is only used by `npm run setup` and `npm run revoke` (demo bootstrap).
# The agent process never signs with it. In the dashboard the owner signs in Phantom.
OWNER_KEYPAIR=~/.config/solana/id.json

# Agent signer (created by setup if missing). Devnet only, holds fee money only.
AGENT_KEYPAIR=./agent-keypair.json

# Printed by `npm run setup`
ROOT_OWNER=
ROOT_ID=
ALLOWED_RECIPIENT=
ATTACKER_ADDRESS=

# LLM through AIMLAPI (OpenAI-compatible). Never commit the key.
AIMLAPI_API_KEY=
MODEL=anthropic/claude-sonnet-4-6

# 1 = force the malicious tool call even if the model ignores the injection
ATTACKER_MODE=0
